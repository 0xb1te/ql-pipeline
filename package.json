{
  "name": "ql-pipeline",
  "version": "0.1.0",
  "description": "AI-governed PR pipeline: conventional-commit routing, per-area rule sets, AI review, and an auto-fix loop, shipped as a reusable GitHub Actions workflow.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ql-pipeline": "dist/main.js"
  },
  "files": [
    "dist",
    "rules",
    "prompts",
    "templates",
    "pipeline.config.yml"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@octokit/rest": "^22.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10"
  }
}
